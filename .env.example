# =============================================================================
# TurboHEDI / Triage — Environment Variables
# Copy this file to .env and replace all CHANGE_ME_BEFORE_PRODUCTION values.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=edi
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
POSTGRES_DB=edi

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=ediapp
RABBITMQ_DEFAULT_PASS=CHANGE_ME_BEFORE_PRODUCTION
RMQ_HOST=rabbitmq
RMQ_PORT=5672
RMQ_USER=ediapp
RMQ_PASS=CHANGE_ME_BEFORE_PRODUCTION
RMQ_VHOST=/
RMQ_QUEUE=edi_files
RMQ_ACKS_QUEUE=acks

# --- Database URL (used by API and Worker) ---
DATABASE_URL=postgresql://edi:CHANGE_ME_BEFORE_PRODUCTION@postgres:5432/edi?sslmode=require

# --- RabbitMQ URL (used by API) ---
RABBITMQ_URL=amqp://ediapp:CHANGE_ME_BEFORE_PRODUCTION@rabbitmq:5672/

# --- Shared API Secret (protects admin/jobs endpoints) ---
TRIAGE_SHARED_SECRET=CHANGE_ME_BEFORE_PRODUCTION

# --- Ollama (AI/LLM inference) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Frontend / Session ---
TRIAGE_SESSION_SECRET=CHANGE_ME_BEFORE_PRODUCTION
TRIAGE_OAUTH2_PROXY_URL=http://rbac:4180
TRIAGE_OAUTH2_PROXY_INTERNAL_URL=http://rbac:4180
TRIAGE_OAUTH2_START=/oauth2/start

# --- CORS (comma-separated origins, or * for dev) ---
TRIAGE_CORS_ORIGINS=*

# --- LDAP ---
LDAP_ADMIN_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
LDAP_CONFIG_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
LDAP_TLS=true
LDAP_TLS_CRT_FILENAME=ldap.crt
LDAP_TLS_KEY_FILENAME=ldap.key
LDAP_TLS_CA_CRT_FILENAME=ca.crt
LDAP_HOST_PORT=3389

# LDAP integration (API-side, optional)
TRIAGE_LDAP_ENABLED=false
TRIAGE_LDAP_URI=ldap://ldap:389
TRIAGE_LDAP_BASE_DN=dc=example,dc=com
TRIAGE_LDAP_BIND_DN=
TRIAGE_LDAP_BIND_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
TRIAGE_LDAP_TIMEOUT=10

# --- Auth / Password Policy ---
TRIAGE_PASSWORD_ITERATIONS=180000
TRIAGE_MIN_PASSWORD_LENGTH=8
TRIAGE_BOOTSTRAP_ADMIN_USER=admin
TRIAGE_BOOTSTRAP_ADMIN_HASH=CHANGE_ME_BEFORE_PRODUCTION

# --- Logging ---
LOG_LEVEL=INFO

# --- Archive ---
ARCHIVE_DIR=/archive
