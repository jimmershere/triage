# =============================================================================
# Triage — Environment Variables
# Copy this file to .env or let scripts/triage-installer.py generate one.
# Replace all CHANGE_ME_BEFORE_PRODUCTION values before shared use.
# =============================================================================

# --- Container image tags / dependency versions ---
TRIAGE_POSTGRES_IMAGE=docker.io/library/postgres:16
TRIAGE_RABBITMQ_IMAGE=docker.io/library/rabbitmq:3-management
TRIAGE_LDAP_IMAGE=docker.io/osixia/openldap:1.5.0
TRIAGE_COMPOSE_NETWORK=triage_default

# --- Published ports ---
FRONTEND_HTTP_PORT=8080
FRONTEND_HTTPS_PORT=8443
API_PORT=8000
RBAC_PORT=4180
POSTGRES_HOST_PORT=15432
RABBITMQ_AMQP_HOST_PORT=15673
RABBITMQ_MGMT_HOST_PORT=35672
LDAP_HOST_PORT=3389
LDAP_LDAPS_HOST_PORT=3636

# --- PostgreSQL ---
POSTGRES_USER=edi
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
POSTGRES_DB=edi
POSTGRES_HOST=postgres
POSTGRES_SSLMODE=disable
POSTGRES_SSL_ENABLED=false
POSTGRES_SSL_CA_FILE=
POSTGRES_SSL_CERT_FILE=
POSTGRES_SSL_KEY_FILE=
DATABASE_URL=postgresql://edi:CHANGE_ME_BEFORE_PRODUCTION@postgres:5432/edi?sslmode=disable

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=ediapp
RABBITMQ_DEFAULT_PASS=CHANGE_ME_BEFORE_PRODUCTION
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_URL=amqp://ediapp:CHANGE_ME_BEFORE_PRODUCTION@rabbitmq:5672/
RMQ_HOST=rabbitmq
RMQ_PORT=5672
RMQ_USER=ediapp
RMQ_PASS=CHANGE_ME_BEFORE_PRODUCTION
RMQ_VHOST=/
RMQ_QUEUE=edi_files
RMQ_ACKS_QUEUE=acks
RABBITMQ_TLS_ENABLED=false
RABBITMQ_TLS_PORT=5671
RABBITMQ_TLS_CA_FILE=
RABBITMQ_TLS_CERT_FILE=
RABBITMQ_TLS_KEY_FILE=

# --- Shared API Secret (protects API write, admin, jobs, and operations endpoints) ---
TRIAGE_SHARED_SECRET=CHANGE_ME_BEFORE_PRODUCTION

# --- Ollama (AI/LLM inference) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
TURBO_PIPELINE_ENABLED=1

# --- Frontend / Session ---
TRIAGE_SESSION_SECRET=CHANGE_ME_BEFORE_PRODUCTION
TRIAGE_API_BASE=http://api:8000
TRIAGE_OAUTH2_PROXY_URL=http://rbac:4180
TRIAGE_OAUTH2_PROXY_INTERNAL_URL=http://rbac:4180
TRIAGE_OAUTH2_START=/oauth2/start
RBAC_API_BASE=http://api:8000
RBAC_COOKIE_SECURE=false

# --- CORS (comma-separated origins, or * for dev) ---
TRIAGE_CORS_ORIGINS=*

# --- LDAP ---
LDAP_ORGANISATION=Triage
LDAP_DOMAIN=example.com
LDAP_ADMIN_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
LDAP_CONFIG_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
LDAP_TLS=true
LDAP_TLS_CRT_FILENAME=ldap.crt
LDAP_TLS_KEY_FILENAME=ldap.key
LDAP_TLS_CA_CRT_FILENAME=ca.crt
LDAP_TLS_CERT_PATH=./deploy/httpd/certs/server.crt
LDAP_TLS_KEY_PATH=./deploy/httpd/certs/server.key
LDAP_TLS_CA_PATH=./deploy/httpd/certs/server.crt

# LDAP integration (API-side, optional)
TRIAGE_LDAP_ENABLED=false
TRIAGE_LDAP_URI=ldap://ldap:389
TRIAGE_LDAP_BASE_DN=dc=example,dc=com
TRIAGE_LDAP_ROOT_CN=ou=TRIAGE
TRIAGE_LDAP_USERS_OU=ou=users
TRIAGE_LDAP_ROLES_OU=ou=roles
TRIAGE_LDAP_TRADING_OU=ou=trading-partners
TRIAGE_LDAP_BIND_DN=
TRIAGE_LDAP_BIND_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION
TRIAGE_LDAP_TIMEOUT=10
TRIAGE_LDAP_ADMIN_DN=
TRIAGE_LDAP_ADMIN_USERNAME=admin
TRIAGE_LDAP_BOOTSTRAP_USERNAME=admin
TRIAGE_LDAP_BOOTSTRAP_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION

# --- Auth / Password Policy ---
TRIAGE_PASSWORD_ITERATIONS=180000
TRIAGE_MIN_PASSWORD_LENGTH=8
TRIAGE_BOOTSTRAP_ADMIN_USER=admin
TRIAGE_BOOTSTRAP_ADMIN_HASH=CHANGE_ME_BEFORE_PRODUCTION

# --- Logging / storage ---
LOG_LEVEL=INFO
ARCHIVE_DIR=/archive

# --- Secrets hygiene / PHI-at-rest (security upgrade) ---
# Fail fast instead of running with protected routes open (set in prod):
TRIAGE_REQUIRE_SECRETS=true
# PHI-at-rest envelope encryption. Generate: openssl rand -base64 32
# When TRIAGE_ENV=production or TRIAGE_REQUIRE_PHI_ENCRYPTION=true, this MUST be set.
TRIAGE_PHI_KEK=
TRIAGE_PHI_ACTIVE_KID=k1
# Retired keys for decrypt-only during rotation: kid:base64key,kid2:base64key
TRIAGE_PHI_KEK_OLD=
# TRIAGE_REQUIRE_PHI_ENCRYPTION=true
