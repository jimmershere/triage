# Shared service defaults
DATABASE_URL=postgresql://edi:edi@postgres:5432/edi
RABBITMQ_URL=amqp://ediapp:3wm078uu@rabbitmq:5672/
RMQ_QUEUE=edi_files
RMQ_ACKS_QUEUE=acks

# Frontend overrides
TRIAGE_API_BASE=http://api:8000
TRIAGE_SESSION_SECRET=change-me-in-prod
PORTAL_HTPASSWD=/app/auth/portal.htpasswd
ADMIN_HTPASSWD=/app/auth/admin.htpasswd
TRIAGE_OAUTH2_PROXY_URL=http://oauth2-proxy:4180
TRIAGE_OAUTH2_START=/oauth2/start

# Legacy compatibility (worker still reads these values)
RMQ_HOST=rabbitmq
RMQ_PORT=5672
RMQ_USER=ediapp
RMQ_PASS=3wm078uu
RMQ_VHOST=/

# Optional OpenLDAP directory wiring
TRIAGE_LDAP_ENABLED=true
LDAP_HOST_PORT=3389

# LDAP containers always listen on 389 internally; expose a different host port
# if needed while keeping the in-cluster URI pointed at 389.
TRIAGE_LDAP_URI=ldap://ldap:389
TRIAGE_LDAP_BASE_DN=dc=example,dc=com
TRIAGE_LDAP_ROOT_CN=cn=HEDI
TRIAGE_LDAP_USERS_OU=ou=users
TRIAGE_LDAP_ROLES_OU=ou=roles
TRIAGE_LDAP_TRADING_OU=ou=trading-partners
TRIAGE_LDAP_BIND_DN=cn=admin,dc=example,dc=com
TRIAGE_LDAP_BIND_PASSWORD=3wm078uu
TRIAGE_LDAP_TIMEOUT=10
TRIAGE_LDAP_BOOTSTRAP_USERNAME=admin
TRIAGE_LDAP_BOOTSTRAP_PASSWORD=3wm078uu

# TLS configuration for the OpenLDAP container. These defaults reuse the
# frontend's certificate bundle so LDAP and the HTTPS portal present the same
# identity. Override the *_PATH values if you need to point at a different
# certificate/key pair.
LDAP_TLS=true
LDAP_TLS_CRT_FILENAME=ldap.crt
LDAP_TLS_KEY_FILENAME=ldap.key
LDAP_TLS_CA_CRT_FILENAME=ca.crt
LDAP_TLS_CERT_PATH=./deploy/httpd/certs/server.crt
LDAP_TLS_KEY_PATH=./deploy/httpd/certs/server.key
LDAP_TLS_CA_PATH=./deploy/httpd/certs/server.crt
